[Unit]
Description=Shopee Sentinel MCP Server (Streamable HTTP)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/sentinel-mcp-server
ExecStart=/opt/sentinel-mcp-server/venv/bin/python -m sentinel_mcp.server --mode http
Restart=always
RestartSec=5

# 环境变量
Environment=SENTINEL_API_BASE=https://priceminder.online/shopee
Environment=SENTINEL_MCP_INTERNAL_KEY=sentinel-mcp-internal-2026
Environment=MCP_MODE=http
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8020
Environment=LOG_LEVEL=info

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
